# Copy this file to .env and adjust if needed. Defaults match docker-compose.yml.

# --- Postgres ---
POSTGRES_USER=banking_user
POSTGRES_PASSWORD=banking_pass
POSTGRES_DB=banking_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Qdrant ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# --- Ollama ---
# Used by code running INSIDE Docker. From your host the container is at http://127.0.0.1:11435
# (that is the default in agent/rag/config.py). Not named OLLAMA_HOST on purpose: native Ollama reads that name.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_LLM_MODEL=mistral
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Mock Bank API ---
BANK_API_KEY=dev-local-key-change-me
BANK_API_HOST=api
BANK_API_PORT=8000

# --- Neo4j (stretch goal, only needed if enabled) ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=banking_pass
